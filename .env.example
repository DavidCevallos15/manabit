# Reseñas de /clases (Firestore). Son los valores de la configuración web de Firebase:
# consola de Firebase > Configuración del proyecto > Tus apps > App web.
# No son secretos, pero la web solo guarda reseñas si están definidos al compilar.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
